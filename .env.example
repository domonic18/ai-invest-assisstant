# Application
DEBUG=true
SECRET_KEY=change-me-in-production

# Deployment / 镜像钉版（仅服务器需要；本地留空 = latest）
# 发布：填 CI 输出的 git 短 sha（如 4cdc1b7）后 docker compose pull && docker compose up -d --wait
# 回滚：改回上一个 sha 重跑同命令
APP_TAG=

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/invest

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invest-files
MINIO_SECURE=false

# Credential encryption (API keys, tokens)
# Must be stable; changing it invalidates existing encrypted credentials.
# Use a long random string or base64-encoded 32-byte key.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

# Optional HTTP/HTTPS proxy for collectors (e.g. http://proxy:3128)
# Leave empty if direct outbound access is available.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,redis,elasticsearch,milvus,minio,localhost,127.0.0.1

# WeChat Mini Program (optional)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
