# ============================================================
# AI Invest Assistant 环境变量配置
# ============================================================
#
# 使用方法:
#   cp .env.example .env
#   按各节注释修改 .env 中的值；改后需 docker compose up -d 重建容器生效
#
# 适用范围:
#   [共用]    - web / beat / worker 全部应用容器都需要
#   [Compose] - 仅 docker compose 编排引用（宿主机端口、基础设施容器凭据）
#   [服务器]  - 仅生产服务器需要，本地开发保持默认/留空
#
# 配置优先级:
#   1. 环境变量（最高优先级，用于生产部署）
#   2. .env 文件
#   3. 代码默认值（backend/app/core/config.py）
#
# 说明:
#   - 默认值面向本地 docker compose 栈（主机名用 compose 服务名，
#     如 postgres / redis / elasticsearch / minio）
#   - 若在宿主机直连运行服务，把各连接串主机名改为 localhost
#   - 连接串支持引用同文件上方已定义的变量（如 ${POSTGRES_USER}）
#   - 未列出的配置项均有代码内置默认值，详见 backend/app/core/config.py
# ============================================================


# ============================================================
# [1] 应用与安全密钥 [共用]  (必须配置)
# ============================================================

# 调试模式（本地 true；生产必须 false）
DEBUG=true

# JWT 会话签名密钥（生产必须更换）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# 凭据加密密钥（加密存储 tushare token 等 API 凭据）
# 必须保持稳定：更换后已存储的加密凭据将全部失效
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key


# ============================================================
# [2] 镜像钉版（发布/回滚）[服务器]  (本地留空)
# ============================================================
# TCR 镜像 tag（ccr.ccs.tencentyun.com/domonic18/{web-api,collector}）:
#   发布: 填 CI 输出的 git 短 sha（如 4cdc1b7），然后
#         docker compose pull && docker compose up -d --wait --no-build
#   回滚: 改回上一个 sha 重跑同命令
#   本地: 留空 = latest（本地栈走 build 不走 pull）

APP_TAG=


# ============================================================
# [3] PostgreSQL [共用/Compose]  (必须配置)
# ============================================================
# POSTGRES_* 三项供 postgres 容器初始化 [Compose]，并被 DATABASE_URL 引用

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=invest

# 应用连接串（容器内走服务名 postgres；宿主机直连改 localhost:${POSTGRES_PORT}）
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}


# ============================================================
# [4] Redis 与 Celery [共用]
# ============================================================
# db0 缓存 / db1 broker / db2 结果，避免键空间互相干扰
# [服务器] REDIS_PASSWORD 必填：生产 compose 以 requirepass 启动 redis
#（公网可达必须认证）；连接串用引用式，密码只存一份：
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
#   CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
#   CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
# 本地栈不设密码，保持无认证直连

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_PASSWORD=


# ============================================================
# [5] Elasticsearch [共用]
# ============================================================
# 新闻搜索与知识库检索（容器内走服务名）

ELASTICSEARCH_URL=http://elasticsearch:9200


# ============================================================
# [6] MinIO 对象存储 [共用/Compose]
# ============================================================
# 存放研报/财报 PDF 等文件；MINIO_ACCESS_KEY/SECRET_KEY 同时是
# minio 容器的 root 凭据 [Compose]

# API 端点（容器内走服务名；COS 填区域域名如 cos.ap-beijing.myqcloud.com）
MINIO_ENDPOINT=minio:9000

# 预签名 URL 的对外可达地址：浏览器必须能访问到
#   本地 = 宿主机映射端口；COS = 区域域名（bucket 由 SDK 前置，勿填 bucket 域名）
#   与 MINIO_ENDPOINT 相同时可省略整行（预签名回落主 client，行为一致）
MINIO_PUBLIC_ENDPOINT=localhost:9002

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invest-files

# 生产 https / COS 时改 true
MINIO_SECURE=false

# Bucket 所在区域（MinIO 留默认 us-east-1；COS 如 ap-beijing，签名必需）
MINIO_REGION=us-east-1

# virtual-host 寻址（COS 等禁 path-style 的服务必须 true；MinIO 留 false）
MINIO_VIRTUAL_HOST=false


# ============================================================
# [7] Celery Worker 队列 [Compose]
# ============================================================
# 拓扑: worker 合并消费 realtime+batch（batch 定点盘后、realtime 盘中，
#       时间窗错开互不挤占）；heavy 独立容器承载 LLM 分钟级任务（复盘/归因）
# 并发与子进程回收等调优项未列出——默认内置于 docker-compose.yml（${VAR:-默认}），按需覆盖

CELERY_WORKER_QUEUES=collector.realtime,collector.batch
CELERY_HEAVY_QUEUE=collector.heavy


# ============================================================
# [8] 宿主机端口映射 [Compose]
# ============================================================
# 本地 compose 发布到宿主机；生产 overlay 仅 Caddy 80/443 对外服务，
# 另发布 PG/Redis 供 SCF 云函数经公网 IP 直连（可达性由轻量防火墙管控）

WEB_PORT=9000                # web（nginx + FastAPI）
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001      # MinIO 控制台


# ============================================================
# [9] 采集出口代理 [共用]  (可选)
# ============================================================
# 采集器出网代理（如 http://proxy:3128）；留空 = 直连
# NO_PROXY 必须包含容器互联域名，避免内部请求走代理

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,redis,elasticsearch,minio,localhost,127.0.0.1
